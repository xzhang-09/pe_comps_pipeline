# Copy to .env and fill in your values (.env is gitignored — never commit keys).
# All variables are documented in docs/configuration.md#environment-variables.

# --- Required ---

# LLM extraction, judging, and embeddings.
OPENAI_API_KEY=sk-...

# Financial Modeling Prep /profile lookups (free tier works).
FMP_API_KEY=...

# --- Strongly recommended ---

# SEC EDGAR User-Agent / contact identity. A placeholder is used with a logged
# warning if unset.
SEC_IDENTITY="Your Name your.email@example.com"

# --- Optional ---

# Fallback FMP key, tried on 402/403/429 responses.
# FMP_API_KEY_ALTERNATE=...

# Hard cap on FMP calls per run (controlled degradation at the quota wall).
# FMP_DAILY_PROFILE_BUDGET=200

# Parallel EDGAR fundamentals fetching; keep modest (2-4) — SEC courtesy rate
# limits apply.
# EDGAR_FETCH_WORKERS=2
